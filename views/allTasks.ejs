<%- include("header") %>
    <main>
        <section class="py-5">
            <div class="container">
                <div class="row">
                    <div class="col-12 text-center">
                        <h2>All Tasks</h2>
                    </div>
                </div>
            </div>
        </section>
        <section>
            <div class="container">
                <div class="row">
                    <div class="col-lg-6 mx-auto mb-3">
                        <% if(tasks.length===0) { %>
                            <p>No tasks available at the moment</p>
                            <% } else { %>
                                <% tasks.forEach(task=> { %>
                                    <div class="card mb-3">
                                        <div class="card-body">
                                            <h5 class="card-title">
                                                <%= task.title %>
                                            </h5>
                                            <p class="card-text">
                                                <%= task.content %>
                                            </p>
                                        </div>
                                    </div>
                                    <% }) %>
                                    <% } %>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>