<%- include("header") %>
    <main>
        <section class="py-5">
            <div class="container">
                <div class="row">
                    <div class="col-12 text-center">
                        <h1>My Tasks</h1>
                    </div>
                </div>
            </div>
        </section>

        <section>
            <div class="container">

                <div class="row">
                    <% if(tasks.length===0) { %>
                        <div class="col-12 text-center">
                            <p>No tasks available at the moment <a href="/create">Create task</a></p>
                        </div>
                        <% } %>
                            <% tasks.forEach(task=> { %>
                                <div class="col-12">
                                    <div class="card mb-3">
                                        <div class="card-body">
                                            <h5 class="card-title">
                                                <%= task.title %>
                                            </h5>
                                            <p class="card-text">
                                                <%= task.content %>
                                            </p>
                                            <div class="d-flex gap-2 justify-content-end">
                                                <a href="/editTask/<%= task._id %>" class="btn btn-primary">Edit</a>
                                                <a href="/deleteTask/<%= task._id %>" class="btn btn-danger">Delete</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                </div>
            </div>
        </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>